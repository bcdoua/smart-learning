{% extends 'base.html.twig' %}
{% block title %}Étudiants à risque — SmartLearn{% endblock %}

{% block body %}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-exclamation-triangle mr-2 text-danger"></i> Détection des étudiants à risque
    </h1>
    <a href="{{ path('admin_dashboard') }}" class="btn btn-secondary shadow-sm">
        <i class="fas fa-arrow-left fa-sm mr-1"></i> Dashboard
    </a>
</div>

{# Summary cards #}
{% set high_count = items|filter(i => i.level == 'high')|length %}
{% set medium_count = items|filter(i => i.level == 'medium')|length %}
{% set low_count = items|filter(i => i.level == 'low')|length %}

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Risque élevé</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ high_count }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-exclamation-circle fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Risque moyen</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ medium_count }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Risque faible</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ low_count }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-check-circle fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-table mr-2"></i> Analyse détaillée — {{ items|length }} étudiant(s)
        </h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover datatable" width="100%" cellspacing="0">
                <thead>
                    <tr>
                        <th>Étudiant</th>
                        <th>Score de risque</th>
                        <th>Niveau</th>
                        <th>Absences récentes</th>
                        <th>Moyenne</th>
                        <th>Inactivité (jours)</th>
                        <th>Raisons</th>
                    </tr>
                </thead>
                <tbody>
                {% for item in items %}
                    <tr class="{{ item.level == 'high' ? 'table-danger' : (item.level == 'medium' ? 'table-warning' : '') }}">
                        <td>
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name={{ item.student.name|url_encode }}&background={{ item.level == 'high' ? 'e74a3b' : (item.level == 'medium' ? 'f6c23e' : '1cc88a') }}&color=fff&size=32"
                                     class="rounded-circle mr-2" width="32" height="32" alt="">
                                <div>
                                    <div class="font-weight-bold">{{ item.student.name }}</div>
                                    <div class="small text-muted">{{ item.student.email }}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <div class="progress flex-grow-1 mr-2" style="height:8px;">
                                    <div class="progress-bar bg-{{ item.level == 'high' ? 'danger' : (item.level == 'medium' ? 'warning' : 'success') }}"
                                         style="width:{{ item.score }}%"></div>
                                </div>
                                <span class="font-weight-bold">{{ item.score }}%</span>
                            </div>
                        </td>
                        <td>
                            <span class="badge badge-{{ item.level == 'high' ? 'danger' : (item.level == 'medium' ? 'warning' : 'success') }}">
                                <i class="fas fa-{{ item.level == 'high' ? 'exclamation-circle' : (item.level == 'medium' ? 'exclamation-triangle' : 'check-circle') }} mr-1"></i>
                                {{ item.level == 'high' ? 'Élevé' : (item.level == 'medium' ? 'Moyen' : 'Faible') }}
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge badge-{{ item.recentAbsences >= 3 ? 'danger' : 'secondary' }}">
                                {{ item.recentAbsences }}
                            </span>
                        </td>
                        <td class="text-center">
                            {% if item.average > 0 %}
                                <span class="font-weight-bold {{ item.average < 10 ? 'text-danger' : 'text-success' }}">
                                    {{ item.average|number_format(1) }}/20
                                </span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                        <td class="text-center">
                            <span class="badge badge-{{ item.daysInactive >= 14 ? 'warning' : 'success' }}">
                                {{ item.daysInactive == 999 ? 'Jamais connecté' : item.daysInactive ~ ' j' }}
                            </span>
                        </td>
                        <td>
                            {% if item.reasons is empty %}
                                <span class="text-success small"><i class="fas fa-check mr-1"></i>Aucun risque</span>
                            {% else %}
                                {% for reason in item.reasons %}
                                    <span class="badge badge-danger mr-1 mb-1">{{ reason }}</span>
                                {% endfor %}
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="fas fa-check-circle fa-2x text-success mb-2 d-block"></i>
                            Aucun étudiant à risque détecté.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}
