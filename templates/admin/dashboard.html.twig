{% extends 'base.html.twig' %}
{% block title %}Dashboard Admin — SmartLearn{% endblock %}

{% block body %}

{# Page Heading #}
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-tachometer-alt mr-2 text-primary"></i> Dashboard Admin
    </h1>
    <div>
        <a href="{{ path('admin_reports_pdf') }}" target="_blank" class="btn btn-sm btn-danger shadow-sm mr-2">
            <i class="fas fa-file-pdf fa-sm mr-1"></i> Rapport PDF
        </a>
        <a href="{{ path('admin_course_new') }}" class="btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus fa-sm mr-1"></i> Nouveau cours
        </a>
    </div>
</div>

{# ===== STAT CARDS ===== #}
<div class="row">

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Étudiants</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.students }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-user-graduate fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Enseignants</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.teachers }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-chalkboard-teacher fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Cours</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.courses }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-book-open fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Absences</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.absences }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-calendar-times fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>

</div>

{# ===== CHARTS + ACTIVITY ===== #}
<div class="row">

    {# Bar Chart #}
    <div class="col-xl-8 col-lg-7">
        <div class="card shadow mb-4">
            <div class="card-header py-3 d-flex align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-chart-bar mr-2"></i> Vue d'ensemble
                </h6>
            </div>
            <div class="card-body">
                <div class="chart-bar">
                    <canvas id="mainChart"
                            data-values="{{ stats|json_encode|e('html_attr') }}"
                            style="height:250px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    {# Activity Log #}
    <div class="col-xl-4 col-lg-5">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-history mr-2"></i> Activité récente
                </h6>
            </div>
            <div class="card-body" style="max-height:300px;overflow-y:auto;">
                {% for log in logs %}
                <div class="activity-item">
                    <div>
                        <i class="fas fa-circle fa-xs text-primary mr-2"></i>
                        <span class="font-weight-bold small">{{ log.action }}</span>
                        {% if log.user %}
                        <span class="text-muted small"> — {{ log.user.name }}</span>
                        {% endif %}
                    </div>
                    <span class="time">{{ log.createdAt|date('d/m H:i') }}</span>
                </div>
                {% else %}
                <p class="text-muted text-center py-3 small">Aucune activité récente.</p>
                {% endfor %}
            </div>
        </div>
    </div>

</div>

{# ===== POPULAR COURSES ===== #}
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-fire mr-2"></i> Cours populaires
        </h6>
        <a href="{{ path('admin_courses') }}" class="btn btn-sm btn-primary">Voir tous</a>
    </div>
    <div class="card-body">
        <div class="row">
            {% for course in courses %}
            <div class="col-xl-4 col-md-6 mb-3">
                <div class="card border-left-info h-100">
                    <div class="card-body py-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <div class="font-weight-bold text-gray-800">{{ course.title }}</div>
                                <div class="small text-muted mt-1">
                                    <i class="fas fa-users mr-1"></i> {{ course.enrollments|length }} inscrits
                                    &nbsp;|&nbsp;
                                    <span class="badge badge-primary">{{ course.level }}</span>
                                </div>
                            </div>
                            <a href="{{ path('admin_course_edit', {id: course.id}) }}" class="btn btn-sm btn-outline-primary ml-2">
                                <i class="fas fa-pen"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            {% else %}
            <div class="col-12 text-center text-muted py-3">
                <i class="fas fa-book-open fa-2x mb-2"></i><br>Aucun cours.
            </div>
            {% endfor %}
        </div>
    </div>
</div>

{# ===== QUICK ACTIONS ===== #}
<div class="row">
    <div class="col-12">
        <div class="card shadow mb-4">
            <div class="card-header py-3">
                <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-bolt mr-2"></i> Actions rapides</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-2 col-sm-4 mb-2">
                        <a href="{{ path('admin_user_new') }}" class="btn btn-primary btn-block btn-sm">
                            <i class="fas fa-user-plus mr-1"></i> Utilisateur
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-4 mb-2">
                        <a href="{{ path('admin_course_new') }}" class="btn btn-info btn-block btn-sm">
                            <i class="fas fa-plus mr-1"></i> Cours
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-4 mb-2">
                        <a href="{{ path('admin_exam_new') }}" class="btn btn-success btn-block btn-sm">
                            <i class="fas fa-clipboard-check mr-1"></i> Examen
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-4 mb-2">
                        <a href="{{ path('admin_absence_new') }}" class="btn btn-warning btn-block btn-sm">
                            <i class="fas fa-calendar-times mr-1"></i> Absence
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-4 mb-2">
                        <a href="{{ path('admin_risk') }}" class="btn btn-danger btn-block btn-sm">
                            <i class="fas fa-exclamation-triangle mr-1"></i> Risques
                        </a>
                    </div>
                    <div class="col-md-2 col-sm-4 mb-2">
                        <a href="{{ path('admin_export_users') }}" class="btn btn-secondary btn-block btn-sm">
                            <i class="fas fa-file-export mr-1"></i> Export CSV
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
