<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Inscription — SmartLearn Academy</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@200;300;400;600;700;800;900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">
    <link href="{{ asset('assets/css/app.css') }}" rel="stylesheet">
    <style>
        body { background: linear-gradient(180deg, #4e73df 10%, #224abe 100%); }
    </style>
</head>
<body>
<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height:100vh;">
        <div class="col-xl-10 col-lg-12 col-md-9">
            <div class="card o-hidden border-0 shadow-lg my-5">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-lg-5 d-none d-lg-block bg-login-image" style="min-height:500px;"></div>
                        <div class="col-lg-7">
                            <div class="p-5">
                                <div class="text-center mb-4">
                                    <h1 class="h4 text-gray-900 font-weight-bold">
                                        <i class="fas fa-graduation-cap text-primary mr-2"></i>Créer un compte
                                    </h1>
                                    <p class="text-muted">Rejoignez SmartLearn Academy</p>
                                </div>

                                {{ form_start(registrationForm, {attr: {novalidate: 'novalidate'}}) }}
                                    <div class="form-group">
                                        {{ form_label(registrationForm.name, 'Nom complet', {label_attr: {class: 'small font-weight-bold'}}) }}
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-user text-gray-400"></i></span>
                                            </div>
                                            {{ form_widget(registrationForm.name, {attr: {class: 'form-control', placeholder: 'Votre nom complet'}}) }}
                                        </div>
                                        {{ form_errors(registrationForm.name) }}
                                    </div>

                                    <div class="form-group">
                                        {{ form_label(registrationForm.email, 'Adresse email', {label_attr: {class: 'small font-weight-bold'}}) }}
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-envelope text-gray-400"></i></span>
                                            </div>
                                            {{ form_widget(registrationForm.email, {attr: {class: 'form-control', placeholder: 'exemple@email.com'}}) }}
                                        </div>
                                        {{ form_errors(registrationForm.email) }}
                                    </div>

                                    <div class="form-group">
                                        {{ form_label(registrationForm.plainPassword, 'Mot de passe', {label_attr: {class: 'small font-weight-bold'}}) }}
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text"><i class="fas fa-lock text-gray-400"></i></span>
                                            </div>
                                            {{ form_widget(registrationForm.plainPassword, {attr: {class: 'form-control', placeholder: 'Minimum 6 caractères'}}) }}
                                        </div>
                                        {{ form_errors(registrationForm.plainPassword) }}
                                    </div>

                                    {# Render any remaining fields #}
                                    {% for field in registrationForm %}
                                        {% if field.vars.name not in ['name', 'email', 'plainPassword', '_token'] %}
                                            <div class="form-group">
                                                {{ form_label(field, null, {label_attr: {class: 'small font-weight-bold'}}) }}
                                                {{ form_widget(field, {attr: {class: 'form-control'}}) }}
                                                {{ form_errors(field) }}
                                            </div>
                                        {% endif %}
                                    {% endfor %}

                                    {{ form_rest(registrationForm) }}

                                    <button type="submit" class="btn btn-primary btn-user btn-block">
                                        <i class="fas fa-user-plus mr-2"></i> Créer mon compte
                                    </button>
                                {{ form_end(registrationForm) }}

                                <hr>
                                <div class="text-center">
                                    <a class="small" href="{{ path('app_login') }}">
                                        <i class="fas fa-sign-in-alt mr-1"></i> Déjà inscrit ? Se connecter
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
