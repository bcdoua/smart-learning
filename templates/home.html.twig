{% extends 'base.html.twig' %}
{% block title %}SmartLearn Academy — Plateforme E-learning{% endblock %}

{% block body %}

{# ===== HERO ===== #}
<div class="hero-section rounded mb-4">
    <div>
        <p class="text-uppercase font-weight-bold mb-2" style="font-size:.75rem;letter-spacing:.1rem;color:#a5f3fc;">
            Plateforme E-learning SaaS
        </p>
        <h1 class="font-weight-black mb-3">SmartLearn Academy</h1>
        <p class="mb-4">Apprentissage, examens, absences, recommandations IA, chat et notifications en temps réel dans une expérience moderne.</p>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('app_register') }}" class="btn btn-light btn-lg font-weight-bold mr-2">
                <i class="fas fa-rocket mr-2"></i> Commencer gratuitement
            </a>
            <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-lg font-weight-bold">
                <i class="fas fa-sign-in-alt mr-2"></i> Se connecter
            </a>
        </div>
    </div>
</div>

{# ===== FEATURES ROW ===== #}
<div class="row mb-4">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Cours en ligne</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">Vidéos & PDF</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-book-open fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Assistant IA</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">Chatbot intelligent</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-robot fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-info shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Examens</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">Résultats en direct</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-clipboard-check fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Notifications</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">Temps réel</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-bell fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

{# ===== POPULAR COURSES ===== #}
<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex align-items-center justify-content-between">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-fire mr-2"></i> Cours populaires
        </h6>
        {% if app.user %}
        <a href="{{ path('student_courses') }}" class="btn btn-sm btn-primary">
            Voir tous <i class="fas fa-arrow-right ml-1"></i>
        </a>
        {% endif %}
    </div>
    <div class="card-body">
        {% if courses is empty %}
            <div class="text-center py-5 text-muted">
                <i class="fas fa-book-open fa-3x mb-3"></i>
                <p>Aucun cours disponible pour le moment.</p>
                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_TEACHER') %}
                <a href="{{ path(is_granted('ROLE_ADMIN') ? 'admin_course_new' : 'teacher_course_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus mr-1"></i> Ajouter un cours
                </a>
                {% endif %}
            </div>
        {% else %}
        <div class="row">
            {% for course in courses %}
            <div class="col-xl-4 col-md-6 mb-4">
                <div class="course-card h-100">
                    <div class="course-thumb d-flex align-items-center justify-content-center">
                        <i class="fas fa-book-open fa-3x text-white opacity-75"></i>
                    </div>
                    <div class="card-body">
                        <h5 class="font-weight-bold">{{ course.title }}</h5>
                        <p class="text-muted small">{{ course.description|slice(0, 110) }}{% if course.description|length > 110 %}...{% endif %}</p>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="badge badge-primary">{{ course.level }}</span>
                            {% if course.category %}
                            <span class="badge badge-info">{{ course.category }}</span>
                            {% endif %}
                        </div>
                        <div class="mt-2 small text-muted">
                            <i class="fas fa-users mr-1"></i> {{ course.enrollments|length }} inscrits
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
</div>

{% endblock %}
