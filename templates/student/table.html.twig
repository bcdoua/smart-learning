{% extends 'base.html.twig' %}
{% block title %}{{ title }} — SmartLearn{% endblock %}

{% block body %}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="fas fa-calendar-times mr-2 text-warning"></i> {{ title }}
    </h1>
    <span class="badge badge-warning" style="font-size:.9rem;padding:.5rem .75rem;">
        {{ items|length }} entrée(s)
    </span>
</div>

{# Breadcrumb #}
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb bg-white shadow-sm px-3 py-2 rounded">
        <li class="breadcrumb-item">
            <a href="{{ path('student_dashboard') }}"><i class="fas fa-home mr-1"></i>Dashboard</a>
        </li>
        <li class="breadcrumb-item active">{{ title }}</li>
    </ol>
</nav>

{# Stats #}
<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Total absences</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">{{ items|length }}</div>
                    </div>
                    <div class="col-auto"><i class="fas fa-calendar-times fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Non justifiées</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            {{ items|filter(i => i.status == 'unjustified')|length }}
                        </div>
                    </div>
                    <div class="col-auto"><i class="fas fa-times-circle fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Justifiées</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">
                            {{ items|filter(i => i.status == 'justified')|length }}
                        </div>
                    </div>
                    <div class="col-auto"><i class="fas fa-check-circle fa-2x text-gray-300"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">
            <i class="fas fa-table mr-2"></i> {{ title }}
            <span class="badge badge-primary ml-1">{{ items|length }}</span>
        </h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover" width="100%" cellspacing="0">
                <thead class="thead-light">
                    <tr>
                        <th class="text-primary">#</th>
                        <th class="text-primary">Cours</th>
                        <th class="text-primary">Date</th>
                        <th class="text-primary text-center">Statut</th>
                        <th class="text-primary">Motif</th>
                    </tr>
                </thead>
                <tbody>
                {% for item in items %}
                <tr>
                    <td><span class="badge badge-light border">{{ loop.index }}</span></td>
                    <td class="font-weight-bold">{{ item.course.title }}</td>
                    <td>{{ item.dateAbsence|date('d/m/Y') }}</td>
                    <td class="text-center">
                        {% if item.status == 'justified' %}
                            <span class="badge badge-success">
                                <i class="fas fa-check mr-1"></i>Justifiée
                            </span>
                        {% elseif item.status == 'unjustified' %}
                            <span class="badge badge-danger">
                                <i class="fas fa-times mr-1"></i>Non justifiée
                            </span>
                        {% else %}
                            <span class="badge badge-warning">
                                <i class="fas fa-clock mr-1"></i>En attente
                            </span>
                        {% endif %}
                    </td>
                    <td class="text-muted small">{{ item.reason ?? '—' }}</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="5" class="text-center py-5">
                        <i class="fas fa-check-circle fa-3x text-success mb-3 d-block"></i>
                        <p class="text-muted">Aucune absence enregistrée. Bravo !</p>
                    </td>
                </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{% endblock %}
