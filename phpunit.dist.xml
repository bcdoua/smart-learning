<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory="var/.phpunit.cache">
    <php>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="0" force="true"/>
        <env name="APP_SECRET" value="test-secret-ci" force="true"/>
        <env name="DATABASE_URL" value="mysql://app:app@127.0.0.1:3306/test?serverVersion=8.4&amp;charset=utf8mb4" force="true"/>
        <env name="MAILER_DSN" value="null://null" force="true"/>
        <env name="MESSENGER_TRANSPORT_DSN" value="in-memory://" force="true"/>
        <env name="DEFAULT_URI" value="http://localhost" force="true"/>
        <env name="CORS_ALLOW_ORIGIN" value="^https?://localhost$" force="true"/>
        <env name="JWT_SECRET_KEY" value="/tmp/none.pem" force="true"/>
        <env name="JWT_PUBLIC_KEY" value="/tmp/none.pem" force="true"/>
        <env name="JWT_PASSPHRASE" value="test" force="true"/>
        <env name="MERCURE_URL" value="http://localhost/.well-known/mercure" force="true"/>
        <env name="MERCURE_PUBLIC_URL" value="http://localhost/.well-known/mercure" force="true"/>
        <env name="MERCURE_JWT_SECRET" value="test-mercure-secret-0123456789abcdef" force="true"/>
        <env name="OPENAI_API_KEY" value="" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
    </php>
    <testsuites>
        <testsuite name="Smart Learning">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
